# ---------------------------------------------------------------
# KNGindica — variáveis de ambiente
# Copie para .env e preencha. O .env é ignorado pelo git.
# ---------------------------------------------------------------

# Supabase (obrigatório — o app não sobe sem estes dois)
# Encontre em: Dashboard do projeto > Project Settings > API
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key"

# Praça padrão da plataforma, no formato "Cidade/UF".
# Define placeholders, saudação da MAIA, UF padrão dos formulários e o
# fallback quando o usuário ainda não escolheu cidade.
# Ausente = Rondonópolis/MT.
VITE_DEFAULT_CITY="Rondonópolis/MT"

# OneSignal (opcional — push fica desativado se ausente)
# Encontre em: OneSignal > Settings > Keys & IDs > OneSignal App ID
VITE_ONESIGNAL_APP_ID=""

# ---------------------------------------------------------------
# Segredos de servidor — NÃO usar prefixo VITE_ e NÃO colocar aqui.
# Configure na Edge Function do Supabase:
#   supabase secrets set GEMINI_API_KEY=...
# A chave do Gemini nunca deve chegar ao bundle do frontend.
# ---------------------------------------------------------------
